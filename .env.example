# Model provider — see phases/cli_client.py for the "anthropic" | "ollama" choice.
CLAIMVAL_PROVIDER=ollama
CLAIMVAL_MODEL=qwen3.8:latest
# For CLAIMVAL_PROVIDER=anthropic, set the usual Anthropic credentials
# (ANTHROPIC_API_KEY, or use phase1_model_config's keyring/tier resolution).

# Database — defaults to sqlite:///.data/claimval.db if unset.
# CLAIMVAL_DB_URL=sqlite:///.data/claimval.db

# Storage paths — default to ./.data/... if unset.
# CLAIMVAL_STORE_ROOT=./.data/ontologies
# CLAIMVAL_OUTPUT_DIR=./.data/phase1_output
# CLAIMVAL_REPORTS_DIR=./reports
# CLAIMVAL_SOURCE_DIR=./.data/source

# Max upload size in bytes for POST /api/documents. Defaults to 25 MB.
# CLAIMVAL_MAX_UPLOAD_BYTES=26214400

# API auth token. If unset, a random one is generated and printed at startup
# (see phases/api_auth.py) — set this to keep it stable across restarts.
# CLAIMVAL_API_TOKEN=
